# Frontend (Vite) - API base URL for admin app
VITE_API_BASE_URL=http://localhost:5000

# RapidAPI Configuration (required for video analysis)
RAPIDAPI_KEY=your_rapidapi_key_here

# OpenAI Configuration (required for 18-D extraction and embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=5000

# Supabase Configuration (required for data persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Neo4j Configuration (required for knowledge graph)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
    